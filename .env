# WebServer_Ultimate 环境变量配置示例
# 使用方式：复制此文件为 .env，然后修改配置
# 在 Linux 中，可以使用以下命令加载：
#   export $(cat .env | xargs)
# 或使用 systemd EnvironmentFile 配置

# ==================== 数据库配置 ====================

# 数据库主机地址（默认：127.0.0.1）
DB_HOST=127.0.0.1

# 数据库端口（默认：3306）
DB_PORT=3306

# 数据库用户名（默认：Wyw）
DB_USER=Wyw

# 数据库密码（必填，无默认值）
# ⚠️ 请务必修改此密码！
DB_PASSWORD=

# 数据库名称（默认：webserver）
DB_NAME=webserver

# 连接池大小（默认：8）
DB_POOL_SIZE=8

# ==================== 使用说明 ====================
#
# 1. 设置环境变量：
#    # 临时设置（当前终端有效）
#    export DB_PASSWORD=your_password
#
#    # 永久设置（添加到 ~/.bashrc 或 ~/.zshrc）
#    echo 'export DB_PASSWORD=your_password' >> ~/.bashrc
#    source ~/.bashrc
#
# 2. 使用 systemd 服务时：
#    创建 /etc/webserver/env 文件，内容同此文件
#    在 service 文件中添加：EnvironmentFile=/etc/webserver/env
#
# 3. 使用 Docker 时：
#    docker run -e DB_PASSWORD=your_password ...
#
#    或使用 docker-compose.yml：
#    environment:
#      - DB_PASSWORD=your_password
#
# 4. 验证配置：
#    启动服务时，日志会显示数据库连接信息（不含密码）
#    如果 DB_PASSWORD 未设置，服务会报错并退出
